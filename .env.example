# ---------------------------------------------------------------------------
# LUMINA configuration. Copy to .env. Secrets live only here, never in code.
# ---------------------------------------------------------------------------

# REQUIRED: the model provider.
ANTHROPIC_API_KEY=sk-ant-...

# --- Web search -------------------------------------------------------------
# Pick one. With none set, LUMINA falls back to a keyless DuckDuckGo HTML
# scrape: it works, but result quality is visibly lower and /health says so.
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SERPER_API_KEY=
# SEARXNG_URL=http://localhost:8888
# SEARCH_PROVIDER=auto                     # auto | tavily | brave | serper | searxng | duckduckgo

# --- Embeddings (document RAG + memory) -------------------------------------
# With none set, a deterministic local lexical embedder is used and retrieval
# leans on the BM25 half of the hybrid. Fine for demos; set a key for quality.
# VOYAGE_API_KEY=
# OPENAI_API_KEY=
# EMBEDDING_PROVIDER=auto                  # auto | voyage | openai | local

# --- Circuit breakers -------------------------------------------------------
# Sit above the SDK's retries: once a dependency is genuinely down, stop paying
# its timeout on every call. State is reported in /health.
#   anthropic     provider faults only (5xx, auth, timeouts, exhausted credit)
#   search:<name> per provider, so the fallback chain skips a dead one
#   fetch:<host>  per host, so a dead host stops eating the run's fetch budget
# LLM_BREAKER_THRESHOLD=4
# LLM_BREAKER_COOLDOWN_MS=30000

# --- MongoDB (optional) -----------------------------------------------------
# Unset means the JSON store, which is right for one container. Set it when you
# need state shared between processes, or a vector index larger than memory.
# Atlas free tier (M0) is enough. A local mongod has no $vectorSearch, so it
# falls back to scanning and /health says which backend is live.
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=lumina
# VECTOR_BACKEND=atlas-vector-search       # or mongo-cosine-scan (local mongod)
# VECTOR_INDEX=chunk_vector_index
# VECTOR_DIM=1024                          # voyage-3.5 = 1024, openai small = 1536

# --- Model routing ----------------------------------------------------------
# One model per role. Most calls in a run are not writing the answer — choosing
# a page to read, splitting a question, noticing a fact about the user — and
# those do not need the model that writes.
#
# These are the defaults. Each is read on its own and NONE of them inherits
# LUMINA_MODEL, deliberately: a deployment that had already set
# LUMINA_MODEL=claude-sonnet-5 would otherwise route every "role" straight back
# to Sonnet and the split would exist only in the code.
#
# LUMINA_QUICK_MODEL=claude-haiku-4-5          # quick research loop and quick answers
# LUMINA_PLANNER_MODEL=claude-haiku-4-5        # deep search decomposition
# LUMINA_BRANCH_MODEL=claude-haiku-4-5         # deep sub-questions (parallel workers)
# LUMINA_DEEP_SYNTHESIS_MODEL=claude-sonnet-5  # merging many sources into one answer
# LUMINA_QUERY_REWRITE_MODEL=claude-haiku-4-5  # turning a follow-up into a standalone query
# LUMINA_MEMORY_MODEL=claude-haiku-4-5         # extracting durable facts after a run
#
# LUMINA_MODEL=claude-sonnet-5             # legacy: now only a default for deep synthesis
# LUMINA_FAST_MODEL=claude-haiku-4-5       # legacy: default for rewrite and memory
#
# Pricing per million tokens: sonnet-5 $2/$10, haiku-4-5 $1/$5. Every call is
# priced at its own model's rate, so a mixed run reports what it actually cost.
# Note: haiku-4-5 rejects adaptive thinking and effort; llm.js shapes requests per model.

# --- Deep search planning ----------------------------------------------------
# DEEP_MIN_SUBQUESTIONS=3                  # below this a decomposition is not one
# DEEP_MAX_SUBQUESTIONS=5
# DEEP_PLAN_CEILING_MS=3500                # planning is deep's first paint; past this it falls back

# --- Services ---------------------------------------------------------------
GATEWAY_PORT=8080
AGENT_PORT=8787
AGENT_URL=http://127.0.0.1:8787
CORS_ORIGINS=*
# INTERNAL_TOKEN=                          # if set, the agent only accepts gateway traffic
# DEMO_PASSWORD=                           # if set, the gateway requires this password (any username)
#                                          set it before exposing LUMINA publicly; openssl rand -base64 24
# AUTH_SECRET=                             # if set, user ids must arrive in a token this gateway signed
#                                          unsigned ids are forgeable, which makes per-user rate limits advisory
#                                          generate: openssl rand -base64 32 · mint: node scripts/mint-token.js
# AUTH_TTL_SECONDS=31536000
# RL_IDENTITY_CAPACITY=15                  # new identities per address before 429 (anti bucket-reset)
# RL_IDENTITY_REFILL=0.2
# DATA_DIR=./data
# LOG_LEVEL=info

# --- Quick mode hard limits -------------------------------------------------
QUICK_MAX_ITERATIONS=4
QUICK_MAX_TOOL_CALLS=6
QUICK_MAX_FETCHES=4
QUICK_MAX_SEARCHES=3
QUICK_WALL_CLOCK_MS=60000
QUICK_EFFORT=medium

# --- Deep Search limits -----------------------------------------------------
DEEP_MAX_SUBQUESTIONS=5
DEEP_BRANCH_MAX_TOOL_CALLS=6
DEEP_BRANCH_MAX_FETCHES=4
DEEP_BRANCH_CONCURRENCY=3
DEEP_WALL_CLOCK_MS=420000
DEEP_EFFORT=high

# --- Rate limits (per user, token bucket) -----------------------------------
RL_QUICK_CAPACITY=20
RL_QUICK_REFILL=0.2
RL_DEEP_CAPACITY=3
RL_DEEP_REFILL=0.01
