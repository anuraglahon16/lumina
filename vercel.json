{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "{src/gateway/public/**,web/dist/**,eval/results-published.json,reports/*.json}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "buildCommand": "npm run build:contract && npm run build -w @lumina/web"
}
