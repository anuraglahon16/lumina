{
  "name": "lumina",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LUMINA - streaming, citation-grounded AI research agent",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/contract",
    "web"
  ],
  "scripts": {
    "dev": "node tools/dev.js",
    "start": "node tools/dev.js",
    "start:gateway": "node src/gateway/server.js",
    "start:agent": "node src/agent/server.js",
    "dev:web": "npm run dev -w @lumina/web",
    "build:contract": "npm run build -w @lumina/contract",
    "bench": "node benchmark/bench.mjs",
    "quality": "node quality/check.mjs .",
    "eval": "node eval/eval.mjs",
    "eval:legacy": "node tools/eval-legacy/run-eval.js",
    "indexes": "node scripts/create-indexes.mjs",
    "export:runs": "node scripts/export-runs.mjs",
    "smoke": "node tools/smoke.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mongodb": "^7.6.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "tldts": "^7.4.13",
    "zod": "^3.24.1"
  }
}
